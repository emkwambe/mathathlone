From a1d7a2d9c8a6f48cd78e3828bc42710506f8fd89 Mon Sep 17 00:00:00 2001
From: Eddy Mkwambe <eddy@mpingo.ai>
Date: Mon, 20 Jul 2026 04:00:38 +0000
Subject: [PATCH 5/5] fix: call CF Worker /init after createHeat so WebSocket
 connections succeed
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Durable Object was never being pre-loaded with heat questions because
the /api/heat/[heatId]/init API route was never called after createHeat().
Every WebSocket upgrade hit an uninitialized DO and failed with 503, which
the browser reported as a WebSocket connection failure in the lobby.

Fix: call /api/heat/{id}/init (fire-and-forget) between the 500ms propagation
wait and the router.push redirect in compete/create/page.tsx. If the init
call fails (e.g. HEAT_ROOM_SECRET not set in Vercel env), a warning is logged
and the lobby falls back to the Supabase transport — no hard failure.
---
 src/app/compete/create/page.tsx | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/app/compete/create/page.tsx b/src/app/compete/create/page.tsx
index 281c3b2..17c8349 100644
--- a/src/app/compete/create/page.tsx
+++ b/src/app/compete/create/page.tsx
@@ -815,6 +815,21 @@ export default function CreateHeatPage() {
       // BUG 0 fix retained — 500ms wait before redirect so the heats row +
       // heat_questions inserts propagate to the read replica.
       await new Promise((r) => setTimeout(r, 500));
+
+      // Pre-load the heat into the Cloudflare HeatRoom Durable Object so
+      // WebSocket connections succeed immediately when the lobby opens.
+      // Fire-and-forget with a best-effort timeout — if it fails the lobby
+      // still works via the Supabase fallback transport.
+      try {
+        const initRes = await fetch(`/api/heat/${heat.id}/init`, { method: 'POST' });
+        if (!initRes.ok) {
+          const body = await initRes.json().catch(() => ({}));
+          console.warn('[CreateHeat] CF init non-fatal:', body);
+        }
+      } catch (initErr) {
+        console.warn('[CreateHeat] CF init error (non-fatal):', initErr);
+      }
+
       router.push(`/compete/${heat.code}`);
     } catch (err: any) {
       console.error('[CreateHeat] failed:', err);
-- 
